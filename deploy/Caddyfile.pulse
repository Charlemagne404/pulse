pulse.continental-hub.com {
	@publicPulseSdk path /pulse.js
	header @publicPulseSdk {
		-Cross-Origin-Resource-Policy
		Access-Control-Allow-Origin "*"
		Cross-Origin-Resource-Policy "cross-origin"
		Cache-Control "public, max-age=300"
	}

	header {
		X-Content-Type-Options "nosniff"
		X-Frame-Options "SAMEORIGIN"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), geolocation=(), microphone=()"
		Cross-Origin-Opener-Policy "same-origin-allow-popups"
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; img-src 'self' data: https:; font-src 'self' https://fonts.gstatic.com; connect-src 'self' https://auth.continental-hub.com; object-src 'none'; base-uri 'self'; frame-ancestors 'self'; form-action 'self'; upgrade-insecure-requests"
	}

	route {
		reverse_proxy /api/* 127.0.0.1:8789
		reverse_proxy /v1/* 127.0.0.1:8789

		root * /var/www/pulse
		try_files {path} /index.html
		file_server
	}
}
