[Unit]
Description=Pulse analytics collector
After=network.target

[Service]
Type=simple
User=charlie
Group=charlie
WorkingDirectory=/home/charlie/pulse
EnvironmentFile=-/etc/pulse/pulse-collector.env
Environment=PULSE_HOST=127.0.0.1
Environment=PULSE_PORT=8789
ExecStart=/usr/bin/node /home/charlie/pulse/server/dist/server.js
Restart=on-failure
RestartSec=3

[Install]
WantedBy=multi-user.target
