[Unit]
Description=Pulse SQLite backup
After=pulse-collector.service
Requires=pulse-collector.service

[Service]
Type=oneshot
User=charlie
Group=charlie
WorkingDirectory=/home/charlie/pulse
EnvironmentFile=-/etc/pulse/pulse-collector.env
ExecStart=/usr/bin/bash /home/charlie/pulse/deploy/backup-pulse.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0027
