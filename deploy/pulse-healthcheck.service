[Unit]
Description=Check Pulse collector health
After=pulse-collector.service

[Service]
Type=oneshot
User=charlie
Group=charlie
EnvironmentFile=-/etc/pulse/pulse-collector.env
ExecStart=/usr/bin/curl --fail --silent --show-error --max-time 10 "$PULSE_HEALTH_URL"
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
UMask=0027
